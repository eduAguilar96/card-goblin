# CardGoblin — cloud-sync config TEMPLATE (committed; copy to .env.local).
#
# Fill these in ONLY if you want to test cloud sync against real R2 from your
# machine. Leave them blank and the editor behaves exactly as it always has:
# local-only, no sign-in, nothing hits the network. Every var is server-side —
# none is prefixed NEXT_PUBLIC_, so none can reach the browser bundle.
#
# The same five values go in Vercel (Project → Settings → Environment
# Variables). Full runbook: docs/deployment.md
#
# Restart `npm run dev` after editing — Next reads env at boot.

# --- Cloudflare R2 (Dashboard → R2 → your bucket / Manage API Tokens) --------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cardgoblin

# --- Admin sign-in ----------------------------------------------------------
# NOT your password — the scrypt hash of it. Generate with:
#     npm run hash-password
# then paste the whole scrypt$... string it prints. Your actual password never
# touches disk, git, or this file; you type it at the sign-in dialog.
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Anyone holding this can forge a session, so treat
# it like a password. At least 32 characters (the server refuses shorter).
#     openssl rand -base64 32
SESSION_SECRET=
